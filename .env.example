# Example NGEC settings. Copy this file to `.env` and uncomment what you need:
#
#     cp .env.example .env
#
# Every setting is optional. With no .env at all, NGEC looks for Elasticsearch
# on localhost:9200 and uses the default attribute model.
#
# .env is read by the tests, the demo, and `ngec-doctor` (which reports where
# each value came from). Your own code has to load it or pass the values in:
# PloverCoder takes an es_client, which ngec.es_client.setup_es_client builds.
# .env is gitignored; never commit one containing passwords.


# --- Elasticsearch, as the pipeline sees it ---------------------------------
# Read by the tests, the demo and examples/plover_app.py.

#ES_HOST=localhost
#ES_PORT=9200
#ES_USER=
#ES_PASSWORD=

# The wiki index for actor resolution's entity splitter. Unlike the rest of the
# pipeline, this does NOT follow ES_HOST / ES_PORT: if you move Elasticsearch
# off localhost:9200, set this to the same cluster as well.
#NGEC_WIKI_URL=http://localhost:9200/wiki


# --- Elasticsearch, as the index-building tools see it ----------------------
# tools/ and elasticsearch/ read this one URL instead of the ES_* values above.
# Nothing keeps the two in step, so point them at the same cluster.
# `ngec-doctor` warns when they disagree.

#NGEC_ES_URL=http://localhost:9200/

# Only needed to rebuild the indices yourself (elasticsearch/compose-build.yml).
# NGEC_ES_DATA must be an ABSOLUTE path: compose does not expand `~`.
#NGEC_ES_DATA=/absolute/path/to/wikigeo_index
#NGEC_ES_PORT=9200
#NGEC_REDIS_HOST=localhost
#NGEC_REDIS_PORT=6379

# Where tools/publish_index.sh uploads a finished index: an rsync target such as
# user@host:/srv/www/ngec/index/. There is deliberately no default.
#NGEC_PUBLISH_DEST=
# Where `ngec download-index` and `ngec update` look for the current index
# release (a mirror serving wikigeo_index_latest.json and the archive it names).
#NGEC_INDEX_LATEST_URL=https://andrewhalterman.com/files/wikigeo_index_latest.json


# --- Models -----------------------------------------------------------------

# The attribute-extraction LLM. The default is ahalt/qwen3.5-event-extraction-0.8b;
# ahalt/qwen3-event-extraction-exp5.1 (the submitted paper's model) and
# ahalt/event-attribute-extractor (the original) are older baselines. A model and
# its prompt format go together, see KNOWN_PROMPT_FORMATS in
# ngec/attribute_model.py.
#NGEC_ATTRIBUTE_MODEL=ahalt/qwen3.5-event-extraction-0.8b

# The sentence encoders actor resolution uses. For evaluation, not everyday use:
# the agent matcher's thresholds are calibrated to its default encoder, so
# changing NGEC_AGENT_ENCODER changes what they mean. See ngec/actors/common.py.
#NGEC_WIKI_ENCODER=sentence-transformers/static-retrieval-mrl-en-v1
#NGEC_AGENT_ENCODER=BAAI/bge-small-en-v1.5

# Where Hugging Face stores downloaded models. Set it if your home directory
# is short on space.
#HF_HOME=

# The `llamacpp` backend runs the model in-process by default. Set a
# llama-server address to use a running server instead.
#NGEC_LLAMACPP_URL=http://127.0.0.1:8080

# Threads for the in-process `llamacpp` backend. The default is the number of
# performance cores, at most 8; using every core is slower on CPUs that also
# have efficiency cores.
#NGEC_LLAMACPP_THREADS=8

# A local GGUF file for the `llamacpp` backend, instead of the one published
# for the attribute model on Hugging Face.
#NGEC_ATTRIBUTE_GGUF=


# --- Demo app only (demo/) --------------------------------------------------

# Shared password asked for before any page renders.
#NGEC_DEMO_PASSWORD=
# `gpu` or `cpu`; defaults to gpu when CUDA is available.
#NGEC_DEMO_MODE=
#NGEC_DEMO_CPU_THREADS=4
# Fraction of the GPU vllm reserves up front.
#NGEC_DEMO_GPU_MEMORY=0.25
# `llamacpp` (needs llama-server running) or `transformers`.
#NGEC_DEMO_CPU_BACKEND=llamacpp
